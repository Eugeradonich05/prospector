{
  "name": "prospector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bot de prospección por WhatsApp para Cuotas al día: tandas asistidas y respuestas automáticas con Claude.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
