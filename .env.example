# URL pública del panel (Vercel o tu dominio)
NEXT_PUBLIC_APP_URL=https://prospector.tudominio.com

# Supabase (Project Settings → API Keys) — solo servidor
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# Acceso al panel
ADMIN_CLAVE=una-clave-larga-que-solo-sepas-vos
SESION_SECRETO=           # openssl rand -hex 24

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-5-5

# WhatsApp — ver README para Meta directo o 360dialog
WHATSAPP_VERIFY_TOKEN=    # inventalo: openssl rand -hex 12
WHATSAPP_TOKEN=           # token permanente de usuario del sistema (o API key del proveedor)
# Tu app de Meta (opción gratis, ver README):
META_APP_ID=
META_CONFIG_ID=
WHATSAPP_APP_SECRET=
# Los da la pantalla «Conectar WhatsApp» al terminar:
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
# 360dialog u otro proveedor compatible (en vez de lo anterior):
# WHATSAPP_API_URL=https://waba-v2.360dialog.io/messages
# WHATSAPP_AUTH_HEADER=D360-API-KEY

# Comportamiento
TANDA_LIMITE=10           # primeros contactos por día (empezá con 10)
TANDA_MAX_POR_CIUDAD=6
BOT_MAX_RESPUESTAS=10     # después de esto, te deriva la conversación
# LINK_PRUEBA=https://cuotasaldia.app/registro   # cuando Cuotas al día esté publicado

# Avisos por email cuando te necesitan (opcional, resend.com)
# RESEND_API_KEY=re_xxx
# EMAIL_AVISOS=eugenioradonich5@gmail.com
# EMAIL_REMITENTE=Prospector <avisos@tudominio.com>
